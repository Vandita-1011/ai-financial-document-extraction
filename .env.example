# ──────────────────────────────────────────────────────────────────────────────
# Document Intelligence Service — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required).
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://docuser:changeme@localhost:5432/docdb

# API key for the Groq inference API (required).
# Obtain one at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Minimum log level emitted by the application (optional, default: INFO).
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Maximum number of pages allowed per uploaded document (optional, default: 3).
MAX_UPLOAD_PAGES=3

# Deployment environment — affects SQL echo and other dev-only behaviour (optional).
# Valid values: development | staging | production
APP_ENV=development
